# Copy this file to .env and fill in your values

# Runtime
NODE_ENV=development
PORT=3000

# Database (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Session (required in production; 16+ chars)
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_NAME=sid

# Proxy (set to 1 on Render/behind reverse proxy for secure cookies)
TRUST_PROXY=1

# Password hashing cost (8-14)
BCRYPT_ROUNDS=12

# Email verification gate for write actions (0 = disabled, 1 = required)
REQUIRE_EMAIL_VERIFICATION=0

# Admin bootstrap / recovery
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_admin_password
ADMIN_EMAIL=admin@example.com
ADMIN_RESET_ON_BOOT=0

# SMTP Configuration (for email verification)
# Leave blank to log verification codes to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
